# ============================================================
# ASTRA INTEL — Environment Variable Template
# ============================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and must NEVER be committed.
#
#   cp .env.example .env   (Linux / macOS)
#   copy .env.example .env (Windows)
# ============================================================

# ── Required ─────────────────────────────────────────────────
# Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Optional overrides (defaults shown) ──────────────────────
# LLM model served by the Groq API (or your local server)
LLM_MODEL=qwen/qwen3-8b

# Base URL — change to http://localhost:11434/v1 for Ollama,
# or any OpenAI-compatible endpoint for other local LLMs
LLM_BASE_URL=https://api.groq.com/openai/v1

# Minimum cosine similarity score to treat a query as "supported"
# by the document. Queries scoring below this are rejected without
# calling the LLM. Range: 0.0 – 1.0 (lower = more permissive).
MIN_SCORE=0.10
